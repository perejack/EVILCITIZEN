{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "env": {
    "DANGEROUSLY_DEPLOY_VULNERABLE_TANSTACK_START_XSS": "1"
  },
  "rewrites": [
    {
      "source": "/api/hashback/initiate",
      "destination": "/api/hashback/initiate.js"
    },
    {
      "source": "/api/hashback/status",
      "destination": "/api/hashback/status.js"
    },
    {
      "source": "/api/hashback/webhook",
      "destination": "/api/hashback/webhook.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
